#!/bin/bash
# Offline load. The container is stopped first (it holds the store), the library loader writes ./holodb-data/holo and
# ./holodb-data/holo.tables and closes the database cleanly (clean-close stamp), then the container starts on the new store.
# Ownership: the loader runs as this user and the container runs as this same uid:gid (see start: --user), so the files need
# no chown and no special umask (the default 022 leaves them owner-writable and readable by the container).
set -e
cd "$(dirname "$0")"
. ./bench.env

./stop
rm -rf holodb-data
dotnet bin/HoloDbServerBench.dll load holodb-data hits.parquet create.sql
rm -f hits.parquet
./start
sync
